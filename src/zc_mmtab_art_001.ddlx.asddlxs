@Metadata.layer: #CORE

@UI.headerInfo: {
    typeName: 'Articulo',
    typeNamePlural: 'Articulos',
    typeImageUrl: '',
    imageUrl: 'URL'

}





annotate entity ZC_MMTAB_ART_001 with
{
  @UI.facet: [
  { id:'DetArt',
  label:'detalle articulo',
  type: #COLLECTION,
  position:10},
  { id: 'Art',
  parentId: 'DetArt',
  label: 'Detalles',
  type:#FIELDGROUP_REFERENCE,
  targetQualifier: 'DetArt',
  position:10}
  ]


  // 3. Agrupación de los campos que formarán la leyenda y los detalles en pantalla
  @UI.identification: [
    { position: 10, label: 'ID de Artículo' },
    { position: 20, label: 'Descripción / Leyenda' },
    { position: 30, label: 'Descripción Adicional' },
    { position: 40, label: 'Color' },
    { position: 50, label: 'Piezas' },
    { position: 60, label: 'Stock Disponible' }
  ]



  //UI.hidden: true
  //lient;

  @UI.lineItem: [{position:10,importance:  #HIGH}]
  @UI.fieldGroup: [{ qualifier: 'DetArt', position:10, label: 'Id Articulo'}]
  @UI.selectionField: [ {   position: 10  } ]
 
  IdArt;
  @UI.lineItem: [{position:20,importance:  #HIGH}]
  @UI.fieldGroup: [{ qualifier: 'DetArt', position:20, label: 'Descripcion'}]
  @UI.selectionField: [ {   position: 20 } ]
  
  Descr;
  @UI.lineItem: [{position:30,importance:  #HIGH}]
  @UI.fieldGroup: [{ qualifier: 'DetArt', position:30, label: 'Stock'}]
  @UI.selectionField: [ {   position: 30 } ]
  Stock;
  //@UI.lineItem: [{position:40,importance:  #HIGH, criticality: 'status'}]
  //status;
  
  //@UI.lineItem: [ {  position: 60,  label: 'URL de Imagen', type: #WITH_URL,  url: 'Url'  }]
  @UI.fieldGroup: [{ qualifier: 'DetArt', position: 70, label: 'URL de Imagen' }]
  Url;


  @UI.fieldGroup: [{ qualifier: 'DetArt', position:30, label: 'descripcion adicional'}]
  Desc2;
  @UI.fieldGroup: [{ qualifier: 'DetArt', position:30, label: 'color'}]
  @UI.selectionField: [ {    position: 30  } ]
  Color;
  @UI.fieldGroup: [{ qualifier: 'DetArt', position:30, label: 'piezas'}]
   @UI.selectionField: [ {    position: 30  } ]
  Piezas;
 //@UI.fieldGroup: [{ qualifier: 'DetArt', position: 60, label: 'Stock Disponible'}]
  //sock;

}